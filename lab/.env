# LLMHound M0 lab environment (example).
#
# lab/scripts/lab-up.sh copies this to lab/.env (which is gitignored) and
# replaces the password placeholder with a random value, so no credential is
# committed. Copy manually at your own risk if you skip lab-up.sh.

# Exact BloodHound CE release under test (M0 pin).
BLOODHOUND_TAG=9.7.1

# Dedicated Compose project name: keeps every container/network/volume of this
# lab namespaced and lets teardown remove only lab resources.
COMPOSE_PROJECT_NAME=llmhound-m0-lab

# PostgreSQL (app database AND graph database with driver=pg).
POSTGRES_USER=bloodhound
POSTGRES_PASSWORD=fff67cb9c0212b4d1b354b3ace9662f11344cd98b91a99c0
POSTGRES_DB=bloodhound

# BloodHound CE is published on loopback only.
BHE_BIND=127.0.0.1
BHE_PORT=18080

# Re-create the default admin on startup (fresh-lab convenience; teardown
# removes volumes anyway).
BHE_RECREATE_DEFAULT_ADMIN=false

# Keep Cypher mutations disabled. The M0 checks use the
# POST /api/v2/clear-database API for deletion semantics instead.
BHE_ENABLE_CYPHER_MUTATIONS=false
